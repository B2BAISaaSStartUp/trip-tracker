<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <Authorizing>
                <MudProgressCircular Indeterminate="true" aria-label="Checking your sign-in" />
            </Authorizing>
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Access denied</MudText>
                    <MudText>Your account may not open this page.</MudText>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <TripTracker.Web.Pages.NotFound />
        </LayoutView>
    </NotFound>
</Router>
