{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "Jwt": {
      "Issuer": "TripTracker",
      "Audience": "TripTracker.Clients",
      "AccessTokenMinutes": 60,
      "RefreshTokenDays": 30
    }
  },
  "Photos": {
    "Storage": {
      "Endpoint": "http://localhost:9000",
      "Bucket": "trip-tracker-photos"
    }
  }
}
